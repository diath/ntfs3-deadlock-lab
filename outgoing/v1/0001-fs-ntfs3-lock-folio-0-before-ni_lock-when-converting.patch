+++ b/fs/ntfs3/frecord.c
@@ -2573,7 +2573,7 @@ int ni_write_frame(struct ntfs_inode *ni, struct page **pages,
 	if (!attr->non_res) {
 		down_write(&ni->file.run_lock);
